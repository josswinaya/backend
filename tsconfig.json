{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",   // Menentukan folder sumber
    "outDir": "./dist",   // Menentukan folder hasil build (opsional untuk dev)
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}